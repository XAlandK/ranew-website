# Copy this file to backend/.env for local development and fill in real
# values. Never commit backend/.env — it is already gitignored.
#
# In production (Render/Railway/Fly.io/etc.), set these as the platform's
# environment variables instead of using a .env file.

# Supabase project URL.
SUPABASE_URL=https://ocpkvqspoxbseoojhwob.supabase.co

# Supabase SERVICE ROLE key (Project Settings -> API -> service_role).
# This key bypasses Row Level Security — keep it server-side only, never
# put it in frontend code or a client-visible env var.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call this API.
# Example for production: https://ranew.org,https://www.ranew.org
# Add your local static-site dev origin too if you serve the frontend
# locally, e.g. http://127.0.0.1:8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Seconds the in-memory correction dictionary is trusted before the next
# request refetches it from Supabase.
CACHE_TTL_SECONDS=600

# Reject uploads larger than this (megabytes).
MAX_UPLOAD_MB=20

# Optional: bearer token required to call POST /api/cache/invalidate.
# Leave unset to disable that endpoint entirely.
ADMIN_TOKEN=
